+/**
+ * Hoist a block signature pi-ai stored on the terminal content block of a
+ * streamed turn, so replay can carry it forward. pi-ai's terminal events carry
+ * only `content` and `partial`; the signature lives on the block at
+ * `contentIndex` inside `partial.content`.
+ * @param event - a terminal block event (`text_end` / `thinking_end`).
+ * @param key - the signature field to read.
+ * @returns the signature, or nothing when the block lacks it.
+ */
+function blockSignature(
+  event: { contentIndex: number; partial: AssistantMessage },
+  key: 'textSignature' | 'thinkingSignature',
+): string | undefined {
+  const block = event.partial.content[event.contentIndex]
+  if (block === undefined) return undefined
+  const signature = key === 'textSignature' && block.type === 'text'
+    ? block.textSignature
+    : key === 'thinkingSignature' && block.type === 'thinking'
+      ? block.thinkingSignature
+      : undefined
+  return typeof signature === 'string' ? signature : undefined
+}
